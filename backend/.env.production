# ============================================================
# TGX Waste Coin - Production Environment
# Sprint 26 - PT Jwalita Energi Trenggalek
# ============================================================

NODE_ENV=production

# Application
PORT=5000
APP_URL=https://api.tgx.jwalita.co.id
FRONTEND_URL=https://tgx.jwalita.co.id

# Database (PostgreSQL)
DATABASE_URL=postgresql://tgx_user:STRONG_PASSWORD@db:5432/tgx_production

# Security
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CORS_ORIGINS=https://tgx.jwalita.co.id,https://admin.tgx.jwalita.co.id

# AI Waste Verification
AI_API_KEY=YOUR_AI_API_KEY_HERE
AI_API_URL=https://api.openai.com/v1

# Storage (for waste images)
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
# AWS_S3_BUCKET=tgx-waste-images
# AWS_REGION=ap-southeast-1

# Email (for notifications & reports)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@jwalita.co.id
EMAIL_PASS=YOUR_APP_PASSWORD

# Redis (for rate limiting & session store in production)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=warn
